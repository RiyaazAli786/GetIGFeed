# Server
PORT=3000
NODE_ENV=development

# Where tokens and feed logs are written (and the pool, when B2 is NOT used).
# Leave blank to use ./data. On Render, point this at a mounted disk (/var/data).
# DATA_DIR=

# --- Backblaze B2 (S3-compatible) storage for the session/proxy pool ---------
# When all four B2_* vars are set, the encrypted pool is stored in B2 instead of
# a local file (secrets stay AES-256-GCM encrypted; B2 only holds the ciphertext).
# Leave blank to keep the pool on the local filesystem.
B2_BUCKET=
B2_ENDPOINT=
B2_REGION=us-east-005
B2_KEY_ID=
B2_APPLICATION_KEY=
# Object key for the pool blob inside the bucket (optional; defaults to pool.json).
# B2_POOL_KEY=pool.json

# Encryption key for the session/proxy pool (AES-256-GCM).
# Any passphrase works (hashed to 32 bytes). REQUIRED in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Admin dashboard (/admin) — passcode required to unlock the CRUD UI.
# Leave blank to disable the dashboard entirely.
ADMIN_PASSCODE=
# Auto-lock window in ms after which an idle dashboard/session locks (default 30s).
ADMIN_IDLE_MS=30000

# Feed fetch tuning
# Number of posts requested on the (single) first page.
FEED_PAGE_COUNT=12
# Serve first-page /api/user-feed responses from the in-memory TTL cache by
# default. Keep false for freshest reads; set true for faster repeat requests.
FEED_CACHE_DEFAULT=false
# Shared TTL for feed/public in-memory cache entries.
CACHE_TTL_MS=30000
# Write each feed response to DATA_DIR/feeds after the API response is sent.
FEED_LOG_ENABLED=true

# CSRF token reuse: a token serves this many requests before it is rotated.
CSRF_MAX_USES=10

# Per-request timeout (ms) for outgoing Instagram/proxy calls. Bounds a dead
# proxy or stalled upstream so the request fails fast instead of the host
# aborting the response stream ("stream aborted"). Default 15000.
HTTP_TIMEOUT_MS=15000

# Proxy "Check" button tuning. The check runs two probes through the proxy: an
# IP-echo (does it tunnel + exit IP) and Instagram (can it actually reach IG),
# retrying across targets so a transient blip doesn't show a false failure.
# PROXY_CHECK_ATTEMPTS=3          # retries before declaring a probe down
# PROXY_CHECK_TIMEOUT_MS=8000     # per-attempt timeout (<= HTTP_TIMEOUT_MS)
# PROXY_CHECK_URL=https://api.ipify.org/?format=json,https://icanhazip.com  # IP-echo targets
# PROXY_CHECK_IG_URL=https://www.instagram.com/api/v1/web/data/shared_data/  # IG reachability probe

# --- Stories & highlights ----------------------------------------------------
# These come from third-party story viewers (storynavigation.com, anonstories.com,
# i.theasmn.com), NOT Instagram's private API — no session or proxy is used.

# Fetch stories + highlights alongside every feed request and merge them into
# the same response (nodes: stories, highlights, highlight_details).
FEED_INCLUDE_STORIES=true
# Also expand every highlight bubble into its media items, returned as the
# highlight_details node keyed by highlight id.
FEED_INCLUDE_HIGHLIGHT_DETAILS=true
# 0 = expand EVERY highlight (default). Each one is an upstream call, so raise
# this off 0 only if you need a bounded response time more than completeness.
FEED_HIGHLIGHT_DETAIL_LIMIT=0
FEED_HIGHLIGHT_DETAIL_CONCURRENCY=5

# Per-request timeout (ms) for the story sources. Separate from HTTP_TIMEOUT_MS,
# which bounds the proxied Instagram calls.
STORY_REQUEST_TIMEOUT_MS=30000

# HEAD-probe the profile picture and swap in the secondary source when the CDN
# link has expired.
VALIDATE_PROFILE_PIC=true

# anonstories.com rate-limits hard (~5 rapid requests -> HTTP 429, then an HTML
# block page) and is the ONLY highlight source for some accounts, so calls to it
# are serialized with this much space between them and successful responses are
# cached for the TTL below. Raise the interval if you still see 429s; raise the
# TTL to make repeat lookups of the same handle cheaper.
STORY_ANON_MIN_INTERVAL_MS=900
STORY_ANON_CACHE_TTL_MS=60000

# One retry for the recoverable failures: a fresh handshake when storynavigation
# says "CSRF token mismatch", and this backoff when anonstories returns 429.
STORY_RETRY=true
STORY_RETRY_DELAY_MS=3000

# Max items accepted by the /api/instagram/download/zip endpoints.
STORY_MAX_ZIP_ITEMS=300

# Puppeteer fallback: scrapes anonyig.com when every HTTP source returns no
# stories for a public account. Requires `npm i puppeteer`.
ENABLE_BROWSER_FALLBACK=false
BROWSER_HEADLESS=true

# --- anonyig (/api/anonyig/*) -----------------------------------------------
# User details, posts, reels, stories and highlights from the anonyig worker hub
# (src/anonyig). Needs no session, no proxy and no setup — the signing chunk it
# uses is downloaded to data/anonyig/ on first request and refreshed on its own
# when the site redeploys. All of these are optional; defaults shown.
ANONYIG_TIMEOUT_MS=20000
# Parallel requests in the per-highlight fan-out.
ANONYIG_CONCURRENCY=4
# Profile headers are cached in-process; every other call resolves the handle
# through one first. 0 disables the cache.
ANONYIG_USER_CACHE_TTL_MS=300000
# ?pages= on /posts and /reels: ~12 posts per page, one upstream call each.
ANONYIG_DEFAULT_PAGES=1
ANONYIG_MAX_PAGES=10
# Where the signing chunk is stored locally (under DATA_DIR by default).
# ANONYIG_CHUNK_PATH=data/anonyig/live_link_chunk.js
# ...and where it is mirrored, in the same B2 bucket the pool uses. This is what
# makes the module work on a host anonyig.com refuses to serve (HTTP 451): run
# `npm run anonyig:chunk` anywhere the site IS reachable and every instance with
# these B2_* credentials can then read the chunk without going there.
B2_ANONYIG_CHUNK_KEY=anonyig/live_link_chunk.js
# ANONYIG_WORKER_HUB=https://api-wh.anonyig.com
# Tunnel the worker hub through a proxy. REQUIRED ON A CLOUD HOST: the hub
# answers 422 CAPTCHA_REQUIRED to addresses it distrusts, and every datacenter
# range is distrusted — a residential/mobile proxy is the point. Accepts
# "http://user:pass@host:port" or the pool's "host:port:user:pass" form.
# ANONYIG_PROXY=
# Or draw one per connection from the encrypted proxy pool the feed uses.
ANONYIG_USE_POOL_PROXY=false

# Optional passthrough headers. wh-cf-token is the captcha token anonyig's own
# page gets after solving a Turnstile challenge; one copied from a browser
# session works instead of a proxy for as long as it stays valid.
# ANONYIG_WH_TOKEN=
# ANONYIG_X_TOKEN=

# --- fastdl (/api/fastdl/*) -------------------------------------------------
# User details, posts, stories and highlights from the FastDL worker hub
# (src/fastdl). Optional; defaults shown. Inherits from ANONYIG variables as fallback.
# FASTDL_TIMEOUT_MS=20000
# Where the signing chunk is stored locally (under DATA_DIR by default).
# FASTDL_CHUNK_PATH=data/fastdl/live_link_chunk.js
# ...and where it is mirrored, in the same B2 bucket the pool uses.
# B2_FASTDL_CHUNK_KEY=fastdl/live_link_chunk.js
# FASTDL_WORKER_HUB=https://api-wh.fastdl.app
# Tunnel the worker hub through a proxy. REQUIRED ON A CLOUD HOST: the hub
# answers 422 CAPTCHA_REQUIRED to distrusted addresses.
# FASTDL_PROXY=
# FASTDL_USE_POOL_PROXY=false

# Debugging (optional)
# Set to 1 to log every outgoing request (URL, proxy, headers, cookies, status).
# DEBUG_HTTP=1
# Set to 0 to accept a debug proxy's self-signed cert (e.g. Fiddler). DEV ONLY.
# NODE_TLS_REJECT_UNAUTHORIZED=0

